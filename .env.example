# TypeSafe AI 或 Vercel AI Gateway 的 API Key
# - 如果是 Vercel AI Gateway Key（以 vck_ 开头），系统会自动路由至 Vercel 网关
TYPESAFE_API_KEY=

# 可选：自定义模型网关 Base URL
# - 使用 Vercel AI Gateway 代理：https://ai-gateway.vercel.sh/typesafe
# - 使用 TypeSafe 官方直连：留空（默认 https://api.typesafe.ai）
# - 使用 Cloudflare AI Gateway / 自建网关：填入自定义 URL
TYPESAFE_BASE_URL=

# Jev 模型版本（默认 jev-latest）
JEV_MODEL=jev-latest

# Liquid AI 的 API Key（支持 D1 决策模型，如 d1:free）
LIQUID_API_KEY=

# Liquid AI Base URL（默认 https://api.liquid.ai/decisions）
LIQUID_BASE_URL=

# D1 模型版本（默认 d1:free）
D1_MODEL=d1:free

# 默认使用的决策模型（jev-latest 或 d1:free，留空则根据配置的 Key 自动选择）
DEFAULT_MODEL=

# 用餐历史回溯窗口（小时，默认 48 小时）
HISTORY_WINDOW_HOURS=48
